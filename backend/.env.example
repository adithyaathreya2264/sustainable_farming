# Copy to .env and fill in real values. .env is gitignored.
# The backend is Node.js (Express + mysql2). Run `npm install` in backend/ first.

# MySQL connection. The SQLAlchemy-style "mysql+pymysql://" prefix is accepted
# (and a plain "mysql://" works too).
DATABASE_URL=mysql+pymysql://sf_app:CHANGE_ME@localhost:3306/sustainable-farming?charset=utf8mb4

# Only needed transiently to provision the schema + app user via mysql.exe.
# Remove once DATABASE_URL above is working.
MYSQL_ROOT_PASSWORD=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Shared secret for the cron-triggered /api/v1/internal/* endpoints — not
# farmer JWT. Generate the same way as JWT_SECRET.
INTERNAL_API_KEY=

# Login is permanently mock: verify-otp accepts MOCK_OTP for ANY phone number
# (no SMS provider is planned) and still issues a real JWT.
MOCK_OTP=123456

# Optional overrides (defaults shown): JWT_ALGORITHM=HS256,
# JWT_EXPIRY_MINUTES=10080 (7 days), PORT=8000

# Comma-separated CORS origins for a browser client (expo start --web, etc.).
# Expo Go native doesn't enforce CORS. "*" is fine for dev; tighten for prod.
CORS_ALLOW_ORIGINS=*

# ML sidecar (ml/serving/, started by `npm run ml` or `npm run dev:all`).
# ML_SIDECAR_URL=http://127.0.0.1:8001
# ML_PYTHON_BIN defaults to ../.venv/Scripts/python.exe (or .venv/bin/python)
# ML_PRELOAD=1 warms every shipped model at sidecar start
